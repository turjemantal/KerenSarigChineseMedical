# ════════════════════════════════════════════════════════════════════════════
#  HOW TO USE THIS FILE
#  1. Copy this file to .env  →  cp .env.example .env
#  2. Fill in the values for your environment (see sections below)
#  3. Never commit .env to git — it contains secrets
# ════════════════════════════════════════════════════════════════════════════

# ─── Environment ─────────────────────────────────────────────────────────────
#
#  DEV   → local development. Real messages ARE sent — same as PROD — so you can
#          verify the full flow end-to-end locally. Use a LOCAL database (a non-PROD
#          process refuses to start against a remote/Atlas DB).
#
#  TEST  → automated tests only. Messaging is SKIPPED. No credentials needed.
#
#  PROD  → production. Real messages are sent. Credentials below become
#          required depending on which MESSAGING_PROVIDER you choose.
#
APP_ENV=DEV               # DEV | TEST | PROD

PORT=3001
CLIENT_URL=http://localhost:5173   # in prod: your domain, e.g. https://kerensarig.co.il

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/keren-clinic   # docker: mongodb://mongo:27017/keren-clinic
# Safety: a non-PROD process refuses to start if MONGODB_URI is a remote/Atlas host,
# so local/dev/test work can never write to production data. Always use a local DB here.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET=change-me
ADMIN_PASSWORD=change-me
# Clinic owner's phone — gets an SMS/WhatsApp alert on every new booking. Empty = disabled.
ADMIN_PHONE=05XXXXXXXX

# ─── Messaging ───────────────────────────────────────────────────────────────
#
#  Choose your provider:
#    sms       → sends real SMS via 019sms.co.il  (fill Section A below)
#    whatsapp  → sends via WhatsApp Cloud API (fill Section B below)
#
#  In TEST mode this value is ignored — nothing is sent regardless.
#
MESSAGING_PROVIDER=sms    # sms | whatsapp

# ── Section A: 019sms.co.il SMS ───────────────────────────────────────────────
#  Required only when:  APP_ENV=DEV/PROD  AND  MESSAGING_PROVIDER=sms
#
#  How to get these (docs: https://docs.019sms.co.il):
#    1. Open an account at 019sms.co.il — your login name is SMS_019_USERNAME
#    2. Generate an API token in their web UI (Settings → API token management)
#       — the token is shown only once! Max 5 active tokens per account.
#    3. 019 requires their "authorized IP" restriction for API access — enable it
#       in Settings and register the server's public IP (prod: the EC2 Elastic IP).
#
#  Sender (SMS_019_SENDER) is the name shown on the recipient's phone:
#    max 11 characters, English letters and digits only, no + sign
#    (one-way — recipients can't reply to an alphanumeric sender).
#
SMS_019_USERNAME=
SMS_019_TOKEN=
SMS_019_SENDER=KerenSarig

# ── Section B: WhatsApp Cloud API ────────────────────────────────────────────
#  Required only when:  APP_ENV=PROD  AND  MESSAGING_PROVIDER=whatsapp
#
#  How to get these:
#    1. Create a Meta developer app at developers.facebook.com
#    2. Add the WhatsApp product and complete business verification
#    3. Pre-approve each message template in the Meta Business Manager
#
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=he
WHATSAPP_TEMPLATE_OTP=otp_code
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=booking_confirmation
# Optional — "request received" template sent on booking (falls back to booking_confirmation until approved by Meta)
WHATSAPP_TEMPLATE_BOOKING_REQUEST=booking_request
# Optional — sent when the admin rejects a pending request. No fallback: the WhatsApp notice is
# skipped until this dedicated template is approved by Meta and set here (SMS sends regardless).
WHATSAPP_TEMPLATE_BOOKING_REJECTED=booking_rejected
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=appointment_reminder
# Optional — admin alert template for new bookings (falls back to booking_confirmation)
WHATSAPP_TEMPLATE_NEW_BOOKING_ALERT=new_booking_alert
# Optional — admin alert template for new website leads (falls back to booking_confirmation)
WHATSAPP_TEMPLATE_LEAD_ALERT=lead_alert

# ─── Google Calendar sync (optional) ─────────────────────────────────────────
#  When set, the server automatically creates/updates/deletes events in Keren's
#  Google Calendar whenever an appointment is approved, rescheduled, or cancelled.
#
#  Setup:
#    1. Google Cloud Console → Enable Calendar API → IAM → Create Service Account
#    2. Download the JSON key file for the service account
#    3. Keren shares her Google Calendar with the service account's email address
#       ("Make changes to events" permission)
#    4. Flatten the JSON to a single line:  jq -c . service-account.json
#    5. Paste that single-line JSON as GOOGLE_CALENDAR_CREDENTIALS below
#    6. Set GOOGLE_CALENDAR_ID to Keren's Google Calendar ID (usually her email,
#       or a specific calendar ID from Google Calendar Settings)
#
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=

# ─── Media (client build) ─────────────────────────────────────────────────────
#  Base URL of the public S3 media bucket (testimonial videos live under /videos/).
#  Read at client BUILD time (Vite) — baked into the bundle, not a runtime var.
VITE_MEDIA_BASE_URL=https://keren-clinic-media.s3.eu-central-1.amazonaws.com

# ─── Logging ──────────────────────────────────────────────────────────────────
#  LOG_LEVEL: fatal|error|warn|info|debug|trace (default: info in prod, debug in dev)
#  Better Stack (optional): ship server logs via the Vector sidecar. Create a
#  "Vector" source in Better Stack and copy its source token + ingesting host.
LOG_LEVEL=info
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGEST_HOST=s00000.xx-xxx-0.betterstackdata.com

# ─── Production only (docker-compose.prod.yml) ────────────────────────────────
#  Full ECR image URLs that the production stack pulls and runs.
#  Format: <account-id>.dkr.ecr.<region>.amazonaws.com/<repo>:latest
#
ECR_SERVER_IMAGE=
ECR_CLIENT_IMAGE=
